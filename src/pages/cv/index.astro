---
/**
 * CV, one page, built from the same data as the site.
 *
 * There is no PDF in the repo on purpose. A committed PDF goes stale the moment
 * a project status changes, and then the CV and the site disagree. This page
 * reads the same `src/data` the portfolio does and carries a print stylesheet,
 * so "Save as PDF" produces a current file every time.
 *
 * English only for now; it will be translated with whichever direction wins.
 */
import { t, tl } from '../../i18n/types';
import { profile } from '../../data/profile';
import { projects, STATUS_LABEL, projectName } from '../../data/projects';
import { stackGroups } from '../../data/stack';
import { timeline, presentLabel } from '../../data/timeline';
import { visibleTestimonials as testimonials } from '../../data/testimonials';
import '../../styles/reset.css';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL;
const home = base.replace(/\/+$/, '') + '/';
const photo = `${base.replace(/\/+$/, '')}/${profile.photo}`;

/**
 * The CV carries three projects, not eight. Luxura and monia shipped and are
 * open to anyone; Storia is pre-launch and earns its line on the integration
 * surface rather than on results. Mate and Femi are strong teardowns and were
 * never launched, so on a document read in thirty seconds they establish
 * "starts many, finishes few" against the two entries that say the opposite.
 * Everything cut is one click away on the portfolio.
 */
const CV_PROJECTS = ['luxura', 'monia', 'storia'];
const cvProjects = CV_PROJECTS.map((id) => projects.find((p) => p.id === id)!);

const work = timeline.filter((e) => e.kind === 'work');
const study = timeline.filter((e) => e.kind === 'education');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Henry Cabello, CV</title>
    <meta name="description" content="Senior full-stack engineer, 8+ years. Curriculum vitae." />
    <meta name="robots" content="noindex" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%97%89%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="sheet">
      <button class="print" type="button" data-print>Save as PDF</button>

      <header class="top">
        <img class="portrait" src={photo} alt={t(profile.photoAlt, lang)} width="96" height="96" />
        <div class="ident">
          <h1>{profile.name}</h1>
          <p class="role">{t(profile.title, lang)} · {t(profile.experience, lang)}</p>
          <p class="contact">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <span>·</span>
            <a href={profile.linkedinUrl}>linkedin.com/in/{profile.linkedin}</a>
            <span>·</span>
            <a href={profile.githubUrl}>github.com/{profile.github}</a>
          </p>
          <p class="contact dim">
            {t(profile.location, lang)} · Remote, US Eastern hours · English C1 · Spanish native
          </p>
        </div>
      </header>

      <section>
        <h2>Profile</h2>
        {/* Opens on the line the site opens on, with the product named. A CV
            has no images to orient the reader, so the name does work the
            generic version cannot. The sentence after it carries what a
            recruiter checks in the first pass: stack, scope, and the years
            inside somebody else's estate. The method paragraph that used to
            sit here holds no checkable fact and lives on the portfolio. */}
        <p class="lede">I built Luxura, ran the server, bought the ads.</p>
        <p>
          Senior full-stack engineer, 8+ years, working in TypeScript, Next.js and PostgreSQL.
          Luxura went from an empty repo to Google Play in eleven weeks and 5,000+ downloads
          across Bogotá and Medellín, and it still runs on infrastructure I operate and pay for.
          Alongside it, five unbroken years at Level60 Consulting building Microsoft Graph, Teams
          and Azure integrations for US corporate clients.
        </p>
      </section>

      <section>
        <h2>Projects</h2>
        {
          cvProjects.map((p) => (
            <article class="item">
              <div class="item-head">
                <h3>
                  {projectName(p, lang)}
                  {p.url && (
                    <a class="ext" href={p.url}>
                      ↗
                    </a>
                  )}
                </h3>
                <span class="meta">
                  {t(STATUS_LABEL[p.status], lang)} · {p.period}
                </span>
              </div>
              <p class="sub">{t(p.tagline, lang)}</p>
              <p>{t(p.summary ?? p.problem, lang)}</p>
              <ul>
                <li><strong>{t(p.decisions[0].title, lang)}.</strong></li>
                <li>{t(p.outcome, lang)}</li>
              </ul>
              <p class="stack">{p.stack.slice(0, 8).join(' · ')}</p>
              {p.caseSlug && (
                <p class="more">
                  <a href={`https://hacu9.github.io/portfolio/${p.caseSlug}/`}>
                    Full teardown: how it was built, what it cost, what I got wrong ↗
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Experience</h2>
        {
          work.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3>{t(e.role, lang)}</h3>
                <span class="meta">
                  {e.from} to {e.to === 'Present' ? t(presentLabel, lang) : e.to}
                </span>
              </div>
              <p class="sub">{e.org}</p>
              {e.detail && <p>{t(e.detail, lang)}</p>}
              {e.highlights && (
                <ul>
                  {tl(e.highlights, lang).map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {
            stackGroups.map((g) => (
              <div>
                <dt>{t(g.label, lang)}</dt>
                <dd>{g.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section>
        <h2>Education</h2>
        <ul class="tight">
          {
            study.map((e) => (
              <li>
                <strong>{t(e.role, lang)}</strong>, {e.org} ({e.from} to {e.to})
              </li>
            ))
          }
        </ul>
      </section>

      {/* No References block: first-name-only quotes carry less on a CV
          than they do on the site, where the surrounding evidence backs them. */}

      <footer class="foot">
        <span>{profile.name}</span>
        <a href={home}>hacu9.github.io/portfolio</a>
      </footer>
    </div>

    <script is:inline>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #14181f;
    --ink-2: #3c4552;
    --dim: #6b7686;
    --line: #d6dae0;
    --accent: #a5620a;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --focus: #a5620a;
  }
  /* Deliberately single-theme: a CV is a document, and it is going to be
     printed on white regardless of the reader's OS preference. */
  body {
    background: #eef0f3;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 10.5pt;
    line-height: 1.5;
  }
  .sheet {
    max-width: 52rem;
    margin: 1.5rem auto;
    background: #fff;
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 10px 40px -20px rgb(0 0 0 / 0.35);
    position: relative;
  }
  .print {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 0.4rem 0.8rem;
    background: #fff;
  }
  .print:hover { border-color: var(--accent); color: var(--accent); }

  .top { display: flex; gap: 1.2rem; align-items: center; border-bottom: 2px solid var(--ink); padding-bottom: 1rem; }
  .portrait { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; flex: none; }
  h1 { font-size: 24pt; letter-spacing: -0.03em; margin: 0; line-height: 1.05; }
  .role { color: var(--accent); font-weight: 600; margin-top: 0.1rem; }
  .contact { font-size: 9pt; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.25rem; }
  .contact.dim { color: var(--dim); }
  .contact a { color: inherit; }

  section { margin-top: 1.4rem; }
  h2 {
    font-family: var(--mono);
    font-size: 8pt;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.25rem;
    margin-bottom: 0.6rem;
  }
  h3 { font-size: 11.5pt; margin: 0; }
  .ext { color: var(--accent); text-decoration: none; margin-left: 0.3rem; }
  .lede { font-size: 11pt; }
  p { max-width: 60ch; }
  p + p { margin-top: 0.4rem; }

  .item + .item { margin-top: 0.9rem; }
  .item-head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  .meta { font-family: var(--mono); font-size: 8pt; color: var(--dim); white-space: nowrap; }
  .sub { color: var(--ink-2); font-size: 9.5pt; font-style: italic; }
  ul { margin: 0.35rem 0 0; padding-left: 1.1rem; }
  li { margin-bottom: 0.18rem; color: var(--ink-2); }
  li strong { color: var(--ink); }
  .tight li { margin-bottom: 0.3rem; }
  .stack { font-family: var(--mono); font-size: 8pt; color: var(--dim); margin-top: 0.3rem; }

  .skills { display: grid; gap: 0.3rem; margin: 0; }
  .skills div { display: grid; grid-template-columns: 10rem 1fr; gap: 0.8rem; }
  .skills dt { font-weight: 650; font-size: 9.5pt; }
  .skills dd { margin: 0; color: var(--ink-2); font-size: 9.5pt; }

  blockquote { margin: 0 0 0.6rem; border-left: 2px solid var(--accent); padding-left: 0.8rem; }
  cite { font-style: normal; font-size: 9pt; color: var(--dim); }

  .foot {
    margin-top: 1.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 8pt;
    color: var(--dim);
  }
  .foot a { color: inherit; }

  @media print {
    @page { margin: 14mm; }
    body { background: #fff; font-size: 9.5pt; }
    .sheet { margin: 0; max-width: none; box-shadow: none; padding: 0; }
    .print { display: none; }
    /* Never split a role or a project across a page break. */
    .item, blockquote, .skills div { break-inside: avoid; }
    h2 { break-after: avoid; }
    .break { break-before: page; }
    a { text-decoration: none; color: inherit; }
  }
</style>
