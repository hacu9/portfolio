---
/**
 * The site, in English, at the root.
 *
 * English is the default language, so it has no prefix. Spanish lives at
 * /es/. This used to be a JavaScript shim that read navigator.language and
 * forwarded to /en/ or /es/. That cost every visitor a redirect, gave search
 * engines a blank page to index at the root, and sent an English recruiter
 * with a Spanish laptop to the wrong version.
 *
 * The language switch in the header is now the only thing that changes
 * language, which is what a reader expects.
 */
import Home from '../layouts/Home.astro';
---

<Home lang="en" />
