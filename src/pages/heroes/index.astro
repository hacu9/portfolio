---
/**
 * Hero bake-off. TEMPORARY.
 *
 * The headline and the lede are the only copy on the site that a reader
 * decides on in six seconds, and they were being argued in a chat window
 * instead of looked at. This renders every candidate in the real display
 * type, on the real background, in both languages, the same way the fourteen
 * design directions were decided.
 *
 * The CSS here is copied from the .boot block in src/layouts/Home.astro, not
 * imported, because the two must be free to drift while this page exists. If
 * you change the hero type in Home.astro and this page still matters, copy it
 * across or the comparison lies.
 *
 * WHEN HENRY PICKS: move the winning pair into profile.positioning and
 * profile.lede, record the losers in the history comment above positioning,
 * then delete this directory. It is noindex, but a chooser page left in a
 * portfolio is worse than no chooser page.
 */
import '../../styles/reset.css';

interface Hero {
  key: string;
  bet: string;
  cost: string;
  en: { h: string; l: string };
  es: { h: string; l: string };
}

const heroes: Hero[] = [
  {
    key: 'A · scars',
    bet: 'The headline opens a loop and nothing closes it. The reader has to write to you to find out. Your current line, with the menu deleted rather than rewritten.',
    cost: 'The hero is still one hundred percent Luxura. The enterprise and AI work stays below the fold.',
    en: {
      h: 'Ask me what broke.',
      l: 'Luxura is live on Google Play. I wrote it, I own the box it runs on, and I buy every user who installs it.',
    },
    es: {
      h: 'Pregúntame qué se rompió.',
      l: 'Luxura está publicada en Google Play. La escribí yo, la máquina donde corre es mía, y le compro cada usuario que instala.',
    },
  },
  {
    key: 'B · stay',
    bet: 'States how you work instead of what you shipped. It is true of all four domains, and "stays to operate it" is the thing a hiring manager is actually screening for. Listed in profile.ts as an alternate already.',
    cost: 'A negative construction, and it is an assertion until the lede pays it off one line later.',
    en: {
      h: "I don't hand things off.",
      l: 'Luxura is live on Google Play: my code, my server, my ad budget. Microsoft enterprise systems, a multi-agent AI platform, a safety product with real-time alerts. Four domains that share nothing, and I stayed to run every one.',
    },
    es: {
      h: 'No entrego el trabajo y me voy.',
      l: 'Luxura está publicada en Google Play: mi código, mi servidor, mi presupuesto de pauta. Sistemas empresariales de Microsoft, una plataforma de IA multiagente, un producto de seguridad con alertas en tiempo real. Cuatro dominios que no comparten nada, y me quedé operando todos.',
    },
  },
  {
    key: 'C · cost',
    bet: 'Keeps the interrogative hook, points it at the one claim almost no other candidate can make. "Broke" is a familiar move now that every engineer writes postmortems. "Cost" is not.',
    cost: 'A reader who stops at the headline may file it as budget talk before the lede resolves it into architecture.',
    en: {
      h: 'Ask me what it cost.',
      l: 'Luxura is live on Google Play. I wrote it, I own the server it runs on, and I buy every user who installs it, so every architecture decision comes back to me with a price on it.',
    },
    es: {
      h: 'Pregúntame cuánto costó.',
      l: 'Luxura está publicada en Google Play. La escribí yo, el servidor donde corre es mío, y le compro cada usuario que instala, así que cada decisión de arquitectura me vuelve con un precio encima.',
    },
  },
  {
    key: 'D · genre',
    bet: 'Attacks the format instead of describing you. Every other portfolio on the pile is demos. This is the only option where the hero is not an ad for one app, which is the structural problem under all of this.',
    cost: 'Three projects carry status "building". A hostile reader can argue with the word "nothing", and you lose the concrete shipped artifact from the first line.',
    en: {
      h: 'Nothing here is a demo.',
      l: 'Microsoft enterprise systems, a multi-agent AI platform, a dating app I run on Google Play, a safety product with real-time alerts. Four domains that share nothing. Every one went to production, and I stayed to operate it.',
    },
    es: {
      h: 'Nada de esto es un demo.',
      l: 'Sistemas empresariales de Microsoft, una plataforma de IA multiagente, una app de citas que opero en Google Play, un producto de seguridad con alertas en tiempo real. Cuatro dominios que no comparten nada. Todos salieron a producción, y en todos me quedé operando.',
    },
  },
];

const boot = {
  en: 'henry@bogota:~$ whoami\nSenior Full-Stack Engineer · 8+ years\nhenry@bogota:~$ cat positioning.txt',
  es: 'henry@bogota:~$ whoami\nIngeniero Full-Stack Senior · 8+ años\nhenry@bogota:~$ cat posicionamiento.txt',
};
const meta = {
  en: 'Bogotá, Colombia · Remote-first · US clients · UTC−5',
  es: 'Bogotá, Colombia · Remoto · clientes en EE. UU. · UTC−5',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero bake-off</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%97%89%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <header class="bar">
      <span class="mark">~/hero-bakeoff</span>
      <div class="tools">
        <button type="button" data-lang="en" class="on">EN</button>
        <button type="button" data-lang="es">ES</button>
        <button type="button" data-theme>◐</button>
      </div>
    </header>

    <p class="how">
      Four complete heroes, each a different bet. Read only the black area:
      that is what a recruiter sees in the first six seconds. The notes under
      each one are for you, not for the page.
    </p>

    {
      heroes.map((hero) => (
        <article class="cand">
          <p class="key">{hero.key}</p>

          <section class="boot">
            {/* Flush against the tags: <pre> keeps the template's indentation. */}
            <pre class="stream" data-en={boot.en} data-es={boot.es}>{boot.en}</pre>
            <h1 data-en={hero.en.h} data-es={hero.es.h}>
              {hero.en.h}
            </h1>
            <p class="hero-lede" data-en={hero.en.l} data-es={hero.es.l}>
              {hero.en.l}
            </p>
            <p class="cursor-line">
              <span class="prompt">henry@bogota:~$</span> <span class="caret" />
            </p>
            <p class="meta" data-en={meta.en} data-es={meta.es}>
              {meta.en}
            </p>
          </section>

          <div class="notes">
            <p><b>The bet.</b> {hero.bet}</p>
            <p><b>What it costs.</b> {hero.cost}</p>
          </div>
        </article>
      ))
    }
  </body>

  <style is:global>
    :root {
      --ground: #050706;
      --raise: #0b0f0d;
      --ink: #cfe3d6;
      --ink-2: #8fae9c;
      --dim: #5b7566;
      --line: #16211b;
      --accent: #3ddc84;
      --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
      --shell: 74rem;
      --pad: clamp(1rem, 3vw, 2.25rem);
    }
    [data-theme='light'] {
      --ground: #f4f6f4;
      --raise: #ffffff;
      --ink: #10221a;
      --ink-2: #35513f;
      --dim: #6d8877;
      --line: #d3ddd6;
      --accent: #0f7b4a;
    }
    body {
      background: var(--raise);
      color: var(--ink);
      font-family: var(--mono);
      margin: 0;
    }

    .bar {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.5rem var(--pad);
      background: var(--raise);
      border-bottom: 1px solid var(--line);
      font-size: 0.75rem;
    }
    .mark {
      color: var(--accent);
    }
    .tools {
      margin-inline-start: auto;
      display: flex;
      gap: 0.4rem;
    }
    .tools button {
      font: inherit;
      cursor: pointer;
      color: var(--dim);
      background: var(--raise);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.15rem 0.5rem;
    }
    .tools button.on,
    .tools button:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    .how {
      max-width: var(--shell);
      margin: 1.5rem auto 0;
      padding-inline: var(--pad);
      font-size: 0.8125rem;
      color: var(--dim);
      max-width: 62ch;
    }

    .cand {
      max-width: var(--shell);
      margin: 2.5rem auto;
      padding-inline: var(--pad);
    }
    .key {
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 0.5rem;
    }

    /* Copied verbatim from the .boot block in src/layouts/Home.astro. */
    .boot {
      background: var(--ground);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: clamp(2.5rem, 8vh, 5rem) var(--pad) clamp(2rem, 5vh, 3rem);
      display: grid;
      gap: 1rem;
    }
    .stream {
      margin: 0;
      color: var(--dim);
      font-size: 0.75rem;
      white-space: pre-wrap;
      min-height: 5.1em;
    }
    .boot h1 {
      font-size: clamp(1.3rem, 2.9vw, 2.05rem);
      line-height: 1.32;
      font-weight: 500;
      color: var(--ink);
      max-width: 46ch;
      letter-spacing: -0.01em;
      margin: 0;
      text-wrap: pretty;
    }
    .hero-lede {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.5;
      color: var(--ink-2);
      max-width: 46ch;
      margin: 0.9rem 0 0;
      text-wrap: pretty;
    }
    .cursor-line {
      margin: 0;
      font-size: 0.75rem;
    }
    .prompt {
      color: var(--accent);
    }
    .caret {
      display: inline-block;
      width: 0.6em;
      height: 1.05em;
      background: var(--accent);
      vertical-align: text-bottom;
      animation: blink 1.1s steps(2) infinite;
    }
    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .caret {
        animation: none;
      }
    }
    .meta {
      color: var(--dim);
      font-size: 0.6875rem;
      margin: 0;
    }

    .notes {
      margin-top: 0.75rem;
      font-size: 0.8125rem;
      color: var(--dim);
      max-width: 70ch;
      display: grid;
      gap: 0.35rem;
    }
    .notes p {
      margin: 0;
    }
    .notes b {
      color: var(--ink-2);
      font-weight: 500;
    }
  </style>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      document.querySelectorAll('[data-lang]').forEach(function (b) {
        b.addEventListener('click', function () {
          var lang = b.getAttribute('data-lang');
          document.querySelectorAll('[data-lang]').forEach(function (o) {
            o.classList.toggle('on', o === b);
          });
          document.querySelectorAll('[data-en]').forEach(function (el) {
            el.textContent = el.getAttribute('data-' + lang);
          });
          root.lang = lang;
        });
      });
      document.querySelector('[data-theme]').addEventListener('click', function () {
        root.setAttribute('data-theme', root.getAttribute('data-theme') === 'light' ? 'dark' : 'light');
      });
    })();
  </script>
</html>
