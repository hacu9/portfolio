---
/**
 * /en/ forwarded to the root.
 *
 * English used to live at /en/. Every link shared before the move points here,
 * so the URL keeps answering instead of returning a 404. GitHub Pages serves
 * static files and cannot send a 301, so this page redirects in the document.
 *
 * `noindex` plus the canonical keeps search engines on the root URL and stops
 * the two addresses from competing for the same page.
 */
const base = import.meta.env.BASE_URL;
const home = `${base.replace(/\/+$/, '')}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <link rel="canonical" href={home} />
    <title>Henry Cabello, Senior Full-Stack Engineer</title>
    <script is:inline define:vars={{ home }}>
      location.replace(home);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #050706;
        color: #d8dee7;
        font-family: system-ui, sans-serif;
      }
      a {
        color: #f0a423;
      }
    </style>
  </head>
  <body>
    <p><a href={home}>Henry Cabello</a></p>
  </body>
</html>
