<style>
  /* ── Violet. Same terminal, different product. ────────────────────────
     --accent is registered so arriving from the work list animates the
     page out of the site's phosphor rather than cutting to it. Structure
     lives in src/styles/case.css; this block is only the palette and the
     conversation thread, which exists on no other page.               */
  @property --accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #3ddc84;
  }

  :root {
    --ground: #0a0812;
    --raise: #12101c;
    --ink: #e4e0ee;
    --ink-2: #a79fbd;
    --dim: #6b6382;
    --line: #221d33;
    --accent: #a98bff;
    --warn: #e0b341;
    --good: #6fc0a8;
    --bad: #e8705a;
    --focus: #a98bff;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    --shell: 74rem;
    --read: 40rem;
    --pad: clamp(1rem, 3vw, 2.25rem);
    animation: enter-storia 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  :global(:root[data-theme='light']) {
    --ground: #f8f6fc;
    --raise: #ffffff;
    --ink: #17141f;
    --ink-2: #453e56;
    --dim: #6b6478;
    --line: #ddd8e8;
    --accent: #6d3bea;
    --warn: #8a6410;
    --good: #0e7c8c;
    --bad: #a6462f;
    --focus: #6d3bea;
    animation-name: enter-storia-light;
  }

  @keyframes enter-storia {
    from { --accent: #3ddc84; }
    to { --accent: #a98bff; }
  }
  @keyframes enter-storia-light {
    from { --accent: #0f7b4a; }
    to { --accent: #6d3bea; }
  }
  @media (prefers-reduced-motion: reduce) {
    :root { animation: none; }
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.68;
  }

  /* ── The conversation ─────────────────────────────────────────────────
     Deliberately not monospace. Everything else on this site is a terminal;
     this is the one place the reader should be looking at what a customer
     sees, and a customer does not see a terminal.                       */
  .thread {
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem 1rem 1.2rem;
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .thread-hd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ground);
    background: var(--accent);
  }
  .who {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }
  .when {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--good);
  }
  .bub {
    max-width: 85%;
    margin: 0;
    padding: 0.45rem 0.75rem;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .bub.in {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    color: var(--ink);
  }
  .bub.out {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--ink);
  }
  .thread-ft {
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--dim);
    margin: 0.6rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
