---
/**
 * The Storía teardown.
 *
 * Same terminal, one directory over, in violet. Structure comes from
 * src/styles/case.css; this file is the palette, the content, and the one
 * component that only exists here: the conversation thread.
 *
 * That thread is the argument. Six lines of Spanish a customer would never
 * think twice about, and underneath them the retrieval, the de-duplication
 * and the CRM write that had to happen for those six lines to be unremarkable.
 * A screenshot of a dashboard would say far less.
 *
 * Figures verified against the repo in August 2026, not copied from the
 * earlier write-up, which had drifted low on line count.
 */
import Base from './Base.astro';
import { t, tl, OTHER_LANG, LANG_LABEL, langPath, asset } from '../i18n/types';
import type { Lang, L, LList } from '../i18n/types';
import { ui } from '../i18n/ui';
import '../styles/reset.css';
import '../styles/case.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = langPath(base, other, 'work/storia');
const indexHref = langPath(base, lang);
const workHref = `${langPath(base, lang)}#work`;
const cvHref = `${base.replace(/\/+$/, '')}/cv/`;
const luxuraHref = langPath(base, lang, 'work/luxura');

const copy = {
