const thread = [
  { side: 'in', es: 'Hola, vi el iPhone en Marketplace. ¿Todavía lo tienen?' },
  { side: 'out', es: 'Sí señor, todavía está. El 13 Pro de 256, en $2.850.000.' },
  { side: 'in', es: '¿Tiene garantía? ¿Y me mandas fotos?' },
  { side: 'out', es: 'Garantía de 6 meses por la tienda. Ya te mando las fotos 📸' },
  { side: 'in', es: 'Listo. ¿Puedo pasar mañana a verlo?' },
  { side: 'out', es: 'Claro, mañana estamos de 9 a 6. ¿A qué hora te queda bien?' },
];
---

<Base
  lang={lang}
  title={t(copy.title, lang)}
  description={t(copy.description, lang)}
  slug="work/storia"
  themeColor="#0a0812"
  grain={false}
>
  <div class="case">
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>~/henry-cabello</a>
    <div class="tools">
      <a class="cv-link" href={cvHref}>CV</a>
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <a class="back" href={workHref}>← {t(copy.back, lang)}</a>

    <section class="hero">
      <span class="pill">{t(copy.status, lang)}</span>
      <h1 style="view-transition-name: proj-storia">Storía</h1>
      <p class="lede">{t(copy.lede, lang)}</p>

      <dl class="kv">
        <div><dt>{t(copy.roleK, lang)}</dt><dd>{t(copy.roleV, lang)}</dd></div>
        <div><dt>{t(copy.builtK, lang)}</dt><dd>{t(copy.builtV, lang)}</dd></div>
        <div>
          <dt>{t(copy.fromK, lang)}</dt>
          <dd><a href={luxuraHref}>Luxura →</a></dd>
        </div>
        <div><dt>{t(copy.stageK, lang)}</dt><dd>{t(copy.stageV, lang)}</dd></div>
      </dl>
    </section>

    {/* The thesis, as a thing that happened rather than a claim about it. */}
    <section class="blk">
      <h2 class="cmd">$ cat ./examples/whatsapp-thread.txt</h2>
      <div class="thread">
        <div class="thread-hd">
          <span class="avatar">M</span>
          <span class="who">Marcela · TechStore</span>
          <span class="when">en línea</span>
        </div>
        {thread.map((m) => <p class={`bub ${m.side}`}>{m.es}</p>)}
        <p class="thread-ft">{t(copy.threadNote, lang)}</p>
      </div>
    </section>

    <figure class="shots">
      <img class="lead-shot" data-zoom src={asset(base, 'images/storia-inbox.jpg')} alt={t(copy.shotInbox, lang)} loading="eager" decoding="async" />
      <div class="pair-shots">
        <img data-zoom src={asset(base, 'images/storia-agent.jpg')} alt={t(copy.shotAgent, lang)} loading="lazy" decoding="async" />
        <img data-zoom src={asset(base, 'images/storia-analytics.jpg')} alt={t(copy.shotAnalytics, lang)} loading="lazy" decoding="async" />
      </div>
      <figcaption>{t(copy.shotsCap, lang)}</figcaption>
    </figure>

    <section class="blk">
      <h2 class="cmd">$ cat ORIGIN.md</h2>
      <div class="out">
        <h3>{t(copy.originH, lang)}</h3>
        {tl(copy.origin, lang).map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat README.md</h2>
      <div class="out">
        <h3>{t(copy.problemH, lang)}</h3>
        {tl(copy.problem, lang).map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ ./bin/stat</h2>
      <div class="grid">
        <div><b>49k</b><span>{lang === 'es' ? 'Líneas TS' : 'Lines TS'}</span></div>
        <div><b>54</b><span>Commits</span></div>
        <div><b>4</b><span>{lang === 'es' ? 'Días' : 'Days'}</span></div>
        <div><b>25</b><span>{lang === 'es' ? 'Modelos' : 'Models'}</span></div>
        <div><b>5</b><span>{lang === 'es' ? 'Canales' : 'Channels'}</span></div>
        <div><b>10</b><span>{lang === 'es' ? 'Herramientas' : 'Agent tools'}</span></div>
        <div><b>12</b><span>{lang === 'es' ? 'Módulos de seguridad' : 'Security modules'}</span></div>
        <div class="hot"><b>1</b><span>{lang === 'es' ? 'Archivo de test' : 'Test file'}</span></div>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat architecture.md</h2>
      <div class="out">
        <h3>{t(copy.pathH, lang)}</h3>
        <p>{t(copy.pathLede, lang)}</p>
        <pre class="term"><span class="k">receive</span>  webhook       verify HMAC · drop replays via Redis · enqueue · <span class="g">200</span>
   <span class="c">│</span>                    <span class="c">// no AI call on this thread</span>
   <span class="c">▼</span>
<span class="k">queue</span>    BullMQ        5 priority queues · payloads carry IDs only
   <span class="c">│</span>                    <span class="c">// messages · knowledge · analytics · broadcasts · notifications</span>
   <span class="c">▼</span>
<span class="k">think</span>    orchestrator  security guard → RAG over pgvector → memory of past wins
   <span class="c">│</span>                  → model with <span class="s">10 tools</span> → second pass to phrase the results
   <span class="c">▼</span>
<span class="k">reply</span>    adapter       rewrite markdown per platform · text then images
                          · mirror into the live inbox</pre>
        <div class="call"><b>{t(copy.tenantT, lang)}</b><p>{t(copy.tenantB, lang)}</p></div>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ ls -la ./hard-parts</h2>
      <div class="out">
        <div class="call"><b>{t(copy.learnT, lang)}</b><p>{t(copy.learnB, lang)}</p></div>
        <div class="call"><b>{t(copy.searchT, lang)}</b><p>{t(copy.searchB, lang)}</p></div>
        <div class="call"><b>{t(copy.secT, lang)}</b><p>{t(copy.secB, lang)}</p></div>
        <div class="call"><b>{t(copy.fmtT, lang)}</b><p>{t(copy.fmtB, lang)}</p></div>
        <div class="call"><b>{t(copy.imgT, lang)}</b><p>{t(copy.imgB, lang)}</p></div>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ diff --chosen --rejected</h2>
      <div class="out">
        <div class="scroll">
          <table>
            <thead>
              <tr>
                <th>{lang === 'es' ? 'Elegí' : 'Chose'}</th>
                <th>{lang === 'es' ? 'En vez de' : 'Instead of'}</th>
                <th>{lang === 'es' ? 'La razón' : 'The one reason'}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="hi">Meta Cloud API</td>
                <td>360dialog · Twilio</td>
                <td>{lang === 'es' ? 'Cero comisión de plataforma y cero recargo por mensaje. Un BSP es comodidad que estaría alquilando para siempre en un producto cuyo margen entero es volumen de mensajes.' : 'Zero platform fee and zero per-message markup. A BSP is convenience I would be renting forever on a product whose whole margin is message volume.'}</td>
              </tr>
              <tr>
                <td class="hi">Postgres + pgvector</td>
                <td>Pinecone · Weaviate</td>
                <td>{lang === 'es' ? 'El corpus es chico y siempre está filtrado por tenant. Una base vectorial dedicada agrega una segunda frontera de consistencia para resolver un problema que no tengo.' : 'The corpus is small and always tenant-filtered. A dedicated vector DB adds a second consistency boundary to solve a problem I do not have.'}</td>
              </tr>
              <tr>
                <td class="hi">BullMQ + Redis</td>
                <td>{lang === 'es' ? 'Colas gestionadas' : 'Managed queues'}</td>
                <td>{lang === 'es' ? 'Todo esto tiene que poder correr en una sola máquina. Redis ya estaba ahí para caché, rate limits y pub/sub.' : 'The whole thing has to be able to run on one box. Redis was already there for caching, rate limits and pub/sub.'}</td>
              </tr>
              <tr>
                <td class="hi">Wompi</td>
                <td>Stripe</td>
                <td>{lang === 'es' ? 'Stripe no da de alta comercios colombianos. Esto se construyó sobre Stripe primero y se arrancó el mismo día, y el commit es el recibo.' : 'Stripe does not onboard Colombian merchants. This was built on Stripe first and ripped out the same day, and the commit is the receipt.'}</td>
              </tr>
              <tr>
                <td class="hi">Capacitor</td>
                <td>React Native</td>
                <td>{lang === 'es' ? 'El panel ya era una web app responsive. Capacitor compró un APK real, push y login nativo sin un segundo codebase.' : 'The dashboard was already a responsive web app. Capacitor bought a real APK, push and native sign-in without a second codebase.'}</td>
              </tr>
              <tr>
                <td class="hi">{lang === 'es' ? 'Dos modelos, uno caro y uno barato' : 'A cheap model and an expensive one'}</td>
                <td>{lang === 'es' ? 'Un solo modelo' : 'One model everywhere'}</td>
                <td>{lang === 'es' ? 'El caro habla con clientes. El barato hace sentimiento, clasificación y extracción de insights. Mismo resultado, una fracción de la cuenta.' : 'The expensive one talks to customers. The cheap one does sentiment, classification and insight extraction. Same result, a fraction of the bill.'}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat voice.md</h2>
      <div class="out">
        <h3>{t(copy.voiceH, lang)}</h3>
        {tl(copy.voice, lang).map((p) => <p>{p}</p>)}
        <ul>{tl(copy.voiceList, lang).map((v) => <li>{v}</li>)}</ul>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat method.md</h2>
      <div class="out">
        <h3>{t(copy.methodH, lang)}</h3>
        <ul>{tl(copy.method, lang).map((m) => <li>{m}</li>)}</ul>
        <p class="foot">{t(copy.methodFoot, lang)}</p>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat STATUS.md</h2>
      <div class="out">
        <h3>{t(copy.positionH, lang)}</h3>
        {tl(copy.position, lang).map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat GAPS.md</h2>
      <div class="out">
        <h3>{t(copy.gapsH, lang)}</h3>
        <p>{t(copy.gapsLede, lang)}</p>
        <div class="scroll">
          <table>
            <tbody>
              {gaps.map((g) => (
                <tr>
                  <td class="hi gap-what">{t(g.what, lang)}</td>
                  <td>{t(g.why, lang)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="blk">
      <h2 class="cmd">$ cat RETRO.md</h2>
      <div class="out">
        <h3>{t(copy.lessonsH, lang)}</h3>
        <ol class="lessons">{tl(copy.lessons, lang).map((l) => <li>{l}</li>)}</ol>
      </div>
    </section>

    <p class="cursor-line" aria-hidden="true">
      <span class="prompt">henry@bogota:~/storia$</span> <span class="caret"></span>
    </p>

    <p class="back-foot"><a href={workHref}>← {t(copy.back, lang)}</a></p>
  </main>
  </div>
</Base>

<style>
  /* ── Violet. Same terminal, different product. ────────────────────────
     --accent is registered so arriving from the work list animates the
     page out of the site's phosphor rather than cutting to it. Structure
     lives in src/styles/case.css; this block is only the palette and the
     conversation thread, which exists on no other page.               */
  @property --accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #3ddc84;
  }

  :root {
    --ground: #0a0812;
    --raise: #12101c;
    --ink: #e4e0ee;
    --ink-2: #a79fbd;
    --dim: #6b6382;
    --line: #221d33;
    --accent: #a98bff;
    --warn: #e0b341;
    --good: #6fc0a8;
    --bad: #e8705a;
    --focus: #a98bff;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    --shell: 74rem;
    --read: 40rem;
    --pad: clamp(1rem, 3vw, 2.25rem);
    animation: enter-storia 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  :global(:root[data-theme='light']) {
    --ground: #f8f6fc;
    --raise: #ffffff;
    --ink: #17141f;
    --ink-2: #453e56;
    --dim: #6b6478;
    --line: #ddd8e8;
    --accent: #6d3bea;
    --warn: #8a6410;
    --good: #0e7c8c;
    --bad: #a6462f;
    --focus: #6d3bea;
    animation-name: enter-storia-light;
  }

  @keyframes enter-storia {
    from { --accent: #3ddc84; }
    to { --accent: #a98bff; }
  }
  @keyframes enter-storia-light {
    from { --accent: #0f7b4a; }
    to { --accent: #6d3bea; }
  }
  @media (prefers-reduced-motion: reduce) {
    :root { animation: none; }
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.68;
  }

  /* ── The conversation ─────────────────────────────────────────────────
     Deliberately not monospace. Everything else on this site is a terminal;
     this is the one place the reader should be looking at what a customer
     sees, and a customer does not see a terminal.                       */
  .thread {
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem 1rem 1.2rem;
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .thread-hd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ground);
    background: var(--accent);
  }
  .who {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }
  .when {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--good);
  }
  .bub {
    max-width: 85%;
    margin: 0;
    padding: 0.45rem 0.75rem;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .bub.in {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    color: var(--ink);
  }
  .bub.out {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--ink);
  }
  .thread-ft {
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--dim);
    margin: 0.6rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bub {
      animation: bub-rise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    }
    .bub:nth-of-type(1) { animation-delay: 0.05s; }
    .bub:nth-of-type(2) { animation-delay: 0.3s; }
    .bub:nth-of-type(3) { animation-delay: 0.55s; }
    .bub:nth-of-type(4) { animation-delay: 0.8s; }
    .bub:nth-of-type(5) { animation-delay: 1.05s; }
    .bub:nth-of-type(6) { animation-delay: 1.3s; }
  }
  @keyframes bub-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .lead-shot,
  .pair-shots img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--raise);
  }
  .pair-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.5rem, 2vw, 1rem);
    margin-top: clamp(0.5rem, 2vw, 1rem);
  }
  @media (max-width: 640px) {
    .pair-shots { grid-template-columns: 1fr; }
  }

  .gap-what {
    white-space: nowrap;
    width: 1%;
  }
</style>
