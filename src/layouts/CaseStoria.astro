    .bub:nth-of-type(5) { animation-delay: 1.05s; }
    .bub:nth-of-type(6) { animation-delay: 1.3s; }
  }
  @keyframes bub-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .gap-what {
    white-space: nowrap;
    width: 1%;
