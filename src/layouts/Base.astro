---
import type { Lang } from '../i18n/types';
import { OTHER_LANG, langPath } from '../i18n/types';
import Motion from '../components/Motion.astro';
import '../styles/motion.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Slug under the language root for a subpage; empty on the home page. Drives canonical + hreflang. */
  slug?: string;
  /** Theme colour for the browser chrome. */
  themeColor?: string;
  /** Film grain over the whole page. Off for the densest layouts. */
  grain?: boolean;
  /** Lenis duration. Heavier pages want a slightly longer glide. */
  scrollDuration?: number;
}

const {
  lang,
  title,
  description,
  slug,
  themeColor = '#0C1017',
  grain = true,
  scrollDuration = 1.05,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const altLang = OTHER_LANG[lang];
// English is the root and Spanish is /es/, so the two URLs are not symmetric.
// langPath() carries that rule; do not rebuild these by hand.
const canonical = new URL(langPath(base, lang, slug ?? ''), Astro.site);
const alternate = new URL(langPath(base, altLang, slug ?? ''), Astro.site);
// Without this every shared link, LinkedIn, WhatsApp, email, previews blank.
const ogImage = new URL(`${base.replace(/\/+$/, '')}/images/og.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={altLang} href={alternate.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={lang === 'en' ? canonical.href : alternate.href}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%97%89%3C/text%3E%3C/svg%3E"
    />

    <!-- Restore the saved theme before first paint so the page never flashes. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hc-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode: fall back to prefers-color-scheme */
        }
      })();
    </script>
  </head>
  <body class={grain ? 'grain' : undefined}>
    <slot />

    <Motion duration={scrollDuration} />

    <!-- Lightbox for [data-zoom] images. One dialog, built on first click.
         Dense product screenshots are unreadable at a third of the column
         width, so opening one full size is the point of showing it.

         The image is constrained on BOTH axes. The first version set only
         width, which sized a 780x1688 phone screenshot to 1382x2992 inside a
         900px viewport: upscaled past its own pixels, and three screens tall,
         so opening it showed less of the screen than the thumbnail did. -->
    <script is:inline>
      (function () {
        var imgs = Array.prototype.slice.call(document.querySelectorAll('[data-zoom]'));
        if (!imgs.length || typeof HTMLDialogElement === 'undefined') return;

        var es = document.documentElement.lang === 'es';
        var dlg, full, cap, count, prev, next, opener, i = 0;

        function show(n) {
          i = (n + imgs.length) % imgs.length;
          var img = imgs[i];
          full.src = img.currentSrc || img.src;
          full.alt = img.alt;
          cap.textContent = img.alt || '';
          count.textContent = imgs.length > 1 ? i + 1 + ' / ' + imgs.length : '';
          prev.hidden = next.hidden = imgs.length < 2;
        }

        function build() {
          dlg = document.createElement('dialog');
          dlg.className = 'case-zoom';

          var close = document.createElement('button');
          close.type = 'button';
          close.className = 'zoom-close';
          close.textContent = es ? 'Cerrar' : 'Close';
          close.addEventListener('click', function () { dlg.close(); });

          prev = document.createElement('button');
          prev.type = 'button';
          prev.className = 'zoom-nav prev';
          prev.setAttribute('aria-label', es ? 'Anterior' : 'Previous');
          prev.innerHTML = '&#8249;';

          next = document.createElement('button');
          next.type = 'button';
          next.className = 'zoom-nav next';
          next.setAttribute('aria-label', es ? 'Siguiente' : 'Next');
          next.innerHTML = '&#8250;';

          prev.addEventListener('click', function (e) { e.stopPropagation(); show(i - 1); });
          next.addEventListener('click', function (e) { e.stopPropagation(); show(i + 1); });

          var fig = document.createElement('figure');
          full = document.createElement('img');
          var figcap = document.createElement('figcaption');
          count = document.createElement('span');
          count.className = 'zoom-count';
          cap = document.createElement('span');
          cap.className = 'zoom-cap';
          figcap.appendChild(count);
          figcap.appendChild(cap);
          fig.appendChild(full);
          fig.appendChild(figcap);

          dlg.addEventListener('click', function (e) {
            if (e.target === dlg || e.target === fig || e.target === full) dlg.close();
          });
          dlg.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
            else if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
          });
          dlg.addEventListener('close', function () {
            if (opener) { opener.focus(); opener = null; }
          });

          dlg.appendChild(close);
          dlg.appendChild(prev);
          dlg.appendChild(fig);
          dlg.appendChild(next);
          document.body.appendChild(dlg);
        }

        imgs.forEach(function (img, n) {
          img.setAttribute('role', 'button');
          img.setAttribute('tabindex', '0');
          img.addEventListener('click', function () {
            if (!dlg) build();
            opener = img;
            show(n);
            dlg.showModal();
          });
          img.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); img.click(); }
          });
        });
      })();
    </script>

    <script is:inline>
      // Theme toggle. Every variant renders a [data-theme-toggle] button.
      (function () {
        var root = document.documentElement;
        function current() {
          var set = root.getAttribute('data-theme');
          if (set) return set;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          b.addEventListener('click', function () {
            var next = current() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('hc-theme', next);
            } catch (e) {
              /* nothing to persist to */
            }
            b.setAttribute('aria-pressed', String(next === 'dark'));
          });
          b.setAttribute('aria-pressed', String(current() === 'dark'));
        });
      })();
    </script>
  </body>
</html>
