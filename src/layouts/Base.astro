---
import type { Lang } from '../i18n/types';
import { OTHER_LANG, langPath } from '../i18n/types';
import Motion from '../components/Motion.astro';
import '../styles/motion.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Slug under the language root for a subpage; empty on the home page. Drives canonical + hreflang. */
  slug?: string;
  /** Theme colour for the browser chrome. */
  themeColor?: string;
  /** Film grain over the whole page. Off for the densest layouts. */
  grain?: boolean;
  /** Lenis duration. Heavier pages want a slightly longer glide. */
  scrollDuration?: number;
}

const {
  lang,
  title,
  description,
  slug,
  themeColor = '#0C1017',
  grain = true,
  scrollDuration = 1.05,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const altLang = OTHER_LANG[lang];
// English is the root and Spanish is /es/, so the two URLs are not symmetric.
// langPath() carries that rule; do not rebuild these by hand.
const canonical = new URL(langPath(base, lang, slug ?? ''), Astro.site);
const alternate = new URL(langPath(base, altLang, slug ?? ''), Astro.site);
// Without this every shared link, LinkedIn, WhatsApp, email, previews blank.
const ogImage = new URL(`${base.replace(/\/+$/, '')}/images/og.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={altLang} href={alternate.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={lang === 'en' ? canonical.href : alternate.href}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%97%89%3C/text%3E%3C/svg%3E"
    />

    <!-- Restore the saved theme before first paint so the page never flashes. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hc-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode: fall back to prefers-color-scheme */
        }
      })();
    </script>
  </head>
  <body class={grain ? 'grain' : undefined}>
    <slot />

    <Motion duration={scrollDuration} />

    <!-- Lightbox for [data-zoom] images. One dialog, built on first click.
         Dense product screenshots are unreadable at a third of the column
         width, so opening one full size is the point of showing it. -->
    <script is:inline>
      (function () {
        var imgs = document.querySelectorAll('[data-zoom]');
        if (!imgs.length || typeof HTMLDialogElement === 'undefined') return;

        var dlg = null;
        var full = null;

        function build() {
          dlg = document.createElement('dialog');
          dlg.className = 'case-zoom';
          full = document.createElement('img');
          var close = document.createElement('button');
          close.type = 'button';
          close.className = 'close';
          close.textContent = document.documentElement.lang === 'es' ? 'Cerrar' : 'Close';
          close.addEventListener('click', function () { dlg.close(); });
          full.addEventListener('click', function () { dlg.close(); });
          dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
          dlg.appendChild(close);
          dlg.appendChild(full);
          document.body.appendChild(dlg);
        }

        imgs.forEach(function (img) {
          img.setAttribute('role', 'button');
          img.setAttribute('tabindex', '0');
          img.addEventListener('click', function () {
            if (!dlg) build();
            full.src = img.currentSrc || img.src;
            full.alt = img.alt;
            dlg.showModal();
          });
          img.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              img.click();
            }
          });
        });
      })();
    </script>

    <script is:inline>
      // Theme toggle. Every variant renders a [data-theme-toggle] button.
      (function () {
        var root = document.documentElement;
        function current() {
          var set = root.getAttribute('data-theme');
          if (set) return set;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          b.addEventListener('click', function () {
            var next = current() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('hc-theme', next);
            } catch (e) {
              /* nothing to persist to */
            }
            b.setAttribute('aria-pressed', String(next === 'dark'));
          });
          b.setAttribute('aria-pressed', String(current() === 'dark'));
        });
      })();
    </script>
  </body>
</html>
